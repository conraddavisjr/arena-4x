# Copy to `.env`. Both the test suite and `scripts/run_match.py` read it; an
# already-exported variable always wins over anything set here.

# API keys. Only the providers named in your match roster need to be set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# ---------------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------------
# The values below are the defaults; setting one here overrides it. These are
# configuration rather than code because model ids move faster than anything
# else in this project - `gemini-3.6-pro`, `grok-4` and `gpt-5.6-mini` were all
# hardcoded here at one point and none of them exists.
#
# Two ways a wrong id shows up, both worth knowing before you change one:
# Google 404s with a suggestion, and xAI reports an unknown model as
# `Incorrect API key provided`, which sends you looking in the wrong place.
# `make contracts` catches either in a few seconds and a few cents.

# The shakeout roster: small, fast, cheap. Run this before a flagship match.
ARENA_SHAKEOUT_ANTHROPIC=claude-haiku-4-5
ARENA_SHAKEOUT_OPENAI=gpt-5.4-mini
ARENA_SHAKEOUT_GOOGLE=gemini-3.6-flash
ARENA_SHAKEOUT_XAI=grok-4.3

# The flagship roster: the actual experiment.
# Note there is no Gemini *pro* above 3.1, and that one is still a preview.
# `gemini-3.7-flash` is newer and GA if you would rather trade tier for
# recency; both pass the contract test.
ARENA_FLAGSHIP_ANTHROPIC=claude-opus-5
ARENA_FLAGSHIP_OPENAI=gpt-5.6
ARENA_FLAGSHIP_GOOGLE=gemini-3.1-pro-preview
ARENA_FLAGSHIP_XAI=grok-4.6

# ---------------------------------------------------------------------------
# Everything else
# ---------------------------------------------------------------------------

# Postgres. The compose file wires this up for you locally.
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5433/arena

# Safety halt, out-of-fiction: the match stops and scores when this is hit.
# Enforced on usage the vendors actually reported, never on an estimate.
MATCH_BUDGET_USD=75
